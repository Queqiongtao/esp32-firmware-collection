menu "Board Support Package"

    config BSP_ERROR_CHECK
        bool "Enable error check in BSP"
        default y
        help
            Error check assert the application before returning the error code.

    menu "I2C"
        config BSP_I2C_NUM
            int "I2C peripheral index"
            default 1
            range 0 1
            help
                ESP32-S2 has two I2C peripherals, pick the one you want to use.

        config BSP_I2C_FAST_MODE
            bool "Enable I2C fast mode"
            default y
            help
                I2C has two speed modes: normal (100kHz) and fast (400kHz).

        config BSP_I2C_CLK_SPEED_HZ
            int
            default 400000 if BSP_I2C_FAST_MODE
            default 100000
    endmenu

    menu "SPIFFS - Virtual File System"
        config BSP_SPIFFS_FORMAT_ON_MOUNT_FAIL
            bool "Format SPIFFS if mounting fails"
            default n
            help
                Format SPIFFS if it fails to mount the filesystem.

        config BSP_SPIFFS_MOUNT_POINT
            string "SPIFFS mount point"
            default "/spiffs"
            help
                Mount point of SPIFFS in the Virtual File System.

        config BSP_SPIFFS_PARTITION_LABEL
            string "Partition label of SPIFFS"
            default "storage"
            help
                Partition label which stores SPIFFS.

        config BSP_SPIFFS_MAX_FILES
            int "Maximum files that could be open at the same time"
            default 2
            help
                Supported max files for SPIFFS in the Virtual File System.
    endmenu

    menu "uSD card - Virtual File System"
        config BSP_SD_FORMAT_ON_MOUNT_FAIL
            bool "Format uSD card if mounting fails"
            default n
            help
                The SDMMC host will format (FAT) the uSD card if it fails to mount the filesystem.

        config BSP_SD_MOUNT_POINT
            string "uSD card mount point"
            default "/sdcard"
            help
                Mount point of the uSD card in the Virtual File System

    endmenu
    menu "Display"
        config BSP_LCD_SPI_PCLK_HZ
            int "Set CO5300 QSPI pixel clock frequency"
            default 60000000
            range 20000000 80000000
            help
                Pixel clock frequency for the CO5300 QSPI LCD panel.
                60 MHz is the component default for smoother full-screen clock rotation.
                If the panel shows artifacts or SPI DMA underflow, reduce this value.

        config BSP_LCD_LVGL_BUFFER_HEIGHT
            int "Set LVGL draw buffer height in pixels"
            default 80
            range 40 466
            help
                Height of each LVGL partial draw buffer. Larger values reduce the number of
                chunks needed for full-screen rotated clock refreshes, but consume more PSRAM.
                The clock app uses double buffering, so memory is roughly width * height * 2
                bytes * 2 buffers.

        config BSP_LCD_TRANS_QUEUE_DEPTH
            int "Set The depth of the SPI transmission task queue for the SPI screen"
            default 1
            range 1 2
            help
                Keep this low for the CO5300 QSPI panel when LVGL draw buffers are in RAM/PSRAM.
                Higher queue depths can let LVGL enqueue the next parameter transaction while a
                previous color DMA transfer is still being recycled, which can trigger SPI DMA
                underflow on ESP-IDF 6.

        config BSP_LCD_TE_SYNC_ENABLE
            bool "Enable CO5300 TE synchronized refresh"
            default y
            help
                Use the CO5300 tearing effect signal on GPIO13 to synchronize LVGL flushes with
                the AMOLED panel refresh. This reduces visible tearing during large rotated
                clock updates. Disable this if the TE line is unavailable on a board revision.
    endmenu

    config BSP_I2S_NUM
        int "I2S peripheral index"
        default 1
        range 0 1
        help
            ESP32S3 has two I2S peripherals, pick the one you want to use.
endmenu

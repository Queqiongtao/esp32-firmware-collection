menu "Fluid Render"

config FLUID_RENDER_SIM_W
    int "Simulation grid width (cells)"
    default 92
    range 8 368

config FLUID_RENDER_SIM_H
    int "Simulation grid height (cells)"
    default 112
    range 8 448

config FLUID_RENDER_SIM_HZ
    int "Simulation/render target rate (Hz)"
    default 30
    range 5 60

config FLUID_RENDER_BLOB_COUNT
    int "Blob count"
    default 8
    range 1 8

config FLUID_RENDER_BLOB_RADIUS_CELLS
    int "Blob base radius (grid cells)"
    default 6
    range 2 24

config FLUID_RENDER_MAX_STRETCH
    int "Max blob stretch along motion (percent)"
    default 135
    range 100 200

config FLUID_RENDER_STATS_INTERVAL_MS
    int "Stats log interval (ms, 0 disables)"
    default 2000
    range 0 60000

config FLUID_RENDER_DEBUG_COLOR_SEQ
    bool "Debug: show red/green/blue color sequence at startup (byte-order check)"
    default n

endmenu

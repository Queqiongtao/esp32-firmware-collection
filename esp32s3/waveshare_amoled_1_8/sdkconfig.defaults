# This file can be edited manually.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_CONSOLE_UART_CUSTOM=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=2000000
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_BOARD_AMOLED_1_8_I2C_SDA_GPIO=15
CONFIG_BOARD_AMOLED_1_8_I2C_SCL_GPIO=14
CONFIG_BOARD_AMOLED_1_8_I2C_PORT=0
CONFIG_BOARD_AMOLED_1_8_I2C_HZ=400000
CONFIG_BOARD_AMOLED_1_8_BACKLIGHT_GPIO=6
CONFIG_BOARD_AMOLED_1_8_BACKLIGHT_LEDC_CHANNEL=0
CONFIG_BOARD_AMOLED_1_8_BACKLIGHT_LEDC_TIMER=0
CONFIG_BOARD_AMOLED_1_8_BACKLIGHT_LEDC_MODE=0
CONFIG_BOARD_AMOLED_1_8_BACKLIGHT_FREQ_HZ=5000

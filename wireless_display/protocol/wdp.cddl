; Wireless Display Protocol 1.0-draft1
; DataChannel CBOR schema. Integer keys are part of the wire contract.

wdp-message =
    hello-message / hello-ack-message / capabilities-message /
    session-start-message / session-accept-message / session-reject-message /
    session-stop-message / permission-request-message / permission-result-message /
    track-manifest-message / surface-config-message / input-key-message /
    input-text-message / device-status-message / telemetry-message /
    error-message / clock-request-message / clock-response-message /
    touch-snapshot-message / pointer-state-message / realtime-telemetry-message

common = (
    0: 1,                         ; version
    2: uint,                      ; message_id
    3: uuid,                      ; session_id
    4: uint,                      ; timestamp_us
    ? 5: uint,                    ; reply_to
    ? 6: uint                     ; flags
)

uuid = bstr .size 16
revision = uint .le 4294967295
sequence = uint .le 4294967295

hello-message = {
    common,
    1: 1,
    7: {
        0: uint,                  ; generation
        1: uint,                  ; max_control_message_bytes
        2: uint                   ; max_realtime_message_bytes
    }
}

hello-ack-message = {
    common,
    1: 2,
    7: {
        0: uint,                  ; generation
        1: uint,                  ; negotiated control maximum
        2: uint                   ; negotiated realtime maximum
    }
}

capabilities-message = {
    common,
    1: 3,
    7: capability-set
}

capability-set = {
    0: revision,
    1: uint .ge 1,                ; max_sessions
    2: uint .ge 4096,             ; max_control_message_bytes
    3: uint .ge 1200,             ; max_realtime_message_bytes
    4: [* surface-capability],
    5: [* media-capability],
    6: [* input-kind],
    7: [* telemetry-kind],
    ? 8: [* tstr],                ; optional features
    ? 9: [* tstr]                 ; required_features
}

surface-capability = {
    0: uint,                      ; surface_id
    1: tstr .size (1..128),       ; name
    2: uint .ge 1,                ; native_width
    3: uint .ge 1,                ; native_height
    4: [* rotation],
    5: uint .ge 1,                ; max_pixel_rate
    6: uint .ge 1,                ; max_fps_milli
    7: [* color-space]
}

rotation = 0 / 90 / 180 / 270
color-space = 1 / 2 / 3           ; srgb / bt709 / display-p3

media-capability = {
    0: uint,                      ; resource_id
    1: track-kind,
    2: direction,
    3: [+ codec-capability],
    ? 4: video-limits,
    ? 5: audio-limits,
    ? 6: uint                     ; max_bitrate_bps
}

track-kind = 1 / 2 / 3 / 4        ; display / playback / microphone / camera
direction = 0 / 1 / 2 / 3         ; inactive / send / recv / sendrecv

codec-capability = {
    0: tstr .size (1..128),       ; MIME type
    ? 1: {* tstr => tstr},        ; fmtp
    ? 2: [* tstr]                 ; RTCP feedback names
}

video-limits = {
    0: uint .ge 1,                ; max_width
    1: uint .ge 1,                ; max_height
    2: uint .ge 1,                ; max_fps_milli
    3: uint .ge 1                 ; max_pixel_rate
}

audio-limits = {
    0: [* uint],                  ; sample rates
    1: uint .ge 1,                ; max_channels
    ? 2: bool,                    ; echo cancellation
    ? 3: bool,                    ; noise suppression
    ? 4: bool                     ; automatic gain control
}

input-kind = 1 / 2 / 3 / 4 / 5 / 6 ; touch / pointer / keyboard / consumer / text / ime
telemetry-kind = standard-telemetry-kind / vendor-telemetry-kind
standard-telemetry-kind = 1..18
vendor-telemetry-kind = 2147483648..4294967295

session-start-message = {
    common,
    1: 4,
    7: {
        0: latency-mode,
        1: [* permission],
        ? 2: uint,                ; target surface_id
        3: [* track-intent]
    }
}

session-accept-message = {
    common,
    1: 5,
    7: {
        0: latency-mode,
        1: [* permission],
        ? 2: uint                 ; target surface_id
    }
}

session-reject-message = {
    common,
    1: 6,
    7: error-payload
}

session-stop-message = {
    common,
    1: 7,
    7: {
        0: stop-reason,
        ? 1: tstr .size (0..256)
    }
}

latency-mode = 1 / 2 / 3          ; interactive / balanced / quality
stop-reason = 0 / 1 / 2 / 3 / 4  ; normal / user / peer / network / error

track-intent = {
    0: track-kind,
    1: direction,
    ? 2: uint,                    ; resource_id
    ? 3: uint                     ; surface_id
}

permission =
    1 / 2 / 3 / 4 / 5 / 6 / 7 / 8 / 9
    ; display_send / display_recv / audio_send / audio_recv /
    ; microphone_send / microphone_recv / input_send / input_recv / telemetry_recv

permission-request-message = {
    common,
    1: 8,
    7: {0: [* permission]}
}

permission-result-message = {
    common,
    1: 9,
    7: {
        0: [* permission],        ; granted
        1: [* permission]         ; denied
    }
}

track-manifest-message = {
    common,
    1: 10,
    7: {
        0: revision,
        1: [* track-binding]
    }
}

track-binding = {
    0: tstr .size (1..64),        ; SDP MID
    1: track-kind,
    2: uint,                      ; resource_id
    3: direction,
    ? 4: uint                     ; surface_id
}

surface-config-message = {
    common,
    1: 11,
    7: {
        0: uint,                  ; surface_id
        1: revision,
        2: uint .ge 1,            ; logical_width
        3: uint .ge 1,            ; logical_height
        4: rotation,
        5: scaling-mode,
        ? 6: rect                 ; content rect
    }
}

scaling-mode = 1 / 2 / 3          ; contain / cover / stretch
rect = [int, int, uint, uint]      ; x, y, width, height

input-key-message = {
    common,
    1: 12,
    7: {
        0: uint .le 65535,        ; USB HID usage page
        1: uint .le 65535,        ; usage
        2: bool,                  ; pressed
        3: uint .le 65535         ; modifier bitmap
    }
}

input-text-message = {
    common,
    1: 13,
    7: {
        0: text-phase,
        1: tstr .size (0..4096),
        ? 2: uint,                ; selection start
        ? 3: uint                 ; selection end
    }
}

text-phase = 1 / 2 / 3 / 4 / 5   ; commit / composition start / update / end / cancel

device-status-message = {
    common,
    1: 14,
    7: {
        0: revision,
        1: power-state,
        2: network-state,
        3: [* permission],
        4: [* uint],              ; active surface ids
        5: [* track-status],
        ? 6: [* uint]             ; active warning codes
    }
}

power-state = 0 / 1 / 2 / 3       ; unknown / external / battery / charging
network-state = 0 / 1 / 2 / 3     ; offline / connecting / connected / degraded
track-status = {0: tstr, 1: track-state} ; MID, state
track-state = 0 / 1 / 2 / 3 / 4 / 5 ; inactive / starting / active / degraded / failed / stopping

telemetry-message = {
    common,
    1: 15,
    7: telemetry-payload
}

realtime-telemetry-message = {
    common,
    1: 34,
    7: telemetry-payload
}

telemetry-payload = {
    0: {* uint => int / uint / float},
    ? 1: uint                     ; sampling interval us
}

error-message = {
    common,
    1: 16,
    7: error-payload
}

error-payload = {
    0: error-code,
    1: tstr .size (0..256),
    2: bool,                      ; fatal
    ? 3: uint                     ; retry_after_ms
}

error-code = 100..112

clock-request-message = {
    common,
    1: 17,
    7: {0: uint}                 ; t1
}

clock-response-message = {
    common,
    1: 18,
    7: {
        0: uint,                  ; t1 echoed
        1: uint,                  ; t2 receive
        2: uint                   ; t3 send
    }
}

touch-snapshot-message = {
    common,
    1: 32,
    7: {
        0: sequence,
        1: uint,                  ; surface_id
        2: revision,
        3: [* touch-contact]
    }
}

touch-contact = {
    0: uint .le 65535,            ; contact_id
    1: uint .le 65535,            ; normalized x
    2: uint .le 65535,            ; normalized y
    ? 3: uint .le 65535,          ; pressure
    ? 4: uint .le 65535,          ; major axis
    ? 5: uint .le 65535,          ; minor axis
    ? 6: int .ge -18000 .le 18000, ; orientation centidegrees
    ? 7: touch-tool
}

touch-tool = 0 / 1 / 2 / 3        ; unknown / finger / stylus / eraser

pointer-state-message = {
    common,
    1: 33,
    7: {
        0: sequence,
        1: uint,                  ; surface_id
        2: revision,
        3: pointer-mode,
        4: int,                   ; x or dx
        5: int,                   ; y or dy
        6: uint,                  ; button bitmap
        ? 7: int,                 ; horizontal wheel
        ? 8: int                  ; vertical wheel
    }
}

pointer-mode = 1 / 2              ; absolute normalized / relative

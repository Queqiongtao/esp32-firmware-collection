{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Companion Display",
  "version": "0.1.0",
  "identifier": "com.companiondisplay.client",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173"
  },
  "app": { "windows": [{ "title": "Companion Display", "width": 1280, "height": 800, "minWidth": 720, "minHeight": 560 }] },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

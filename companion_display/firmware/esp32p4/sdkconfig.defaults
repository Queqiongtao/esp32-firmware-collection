CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=200
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_COMPANION_DISPLAY_WIDTH=1024
CONFIG_COMPANION_DISPLAY_HEIGHT=600
CONFIG_COMPANION_FRAME_LIMIT_KB=384
CONFIG_COMPANION_FRAME_BUFFER_COUNT=2
CONFIG_COMPANION_DRAW_TASK_PRIORITY=5
CONFIG_COMPANION_HTTP_PORT=80
CONFIG_COMPANION_UDP_PORT=5000
CONFIG_COMPANION_AP_PASSWORD="companion-display"

CONFIG_IDF_EXPERIMENTAL_FEATURES=y

CONFIG_EXAMPLE_USE_DMA2D_COPY_FRAME=y
CONFIG_EXAMPLE_LVGL_PORT_ESP_ADAPTER=y
CONFIG_EXAMPLE_LVGL_ADAPTER_TEAR_DOUBLE_DIRECT=y
CONFIG_EXAMPLE_LVGL_ADAPTER_ENABLE_PPA_ACCEL=y

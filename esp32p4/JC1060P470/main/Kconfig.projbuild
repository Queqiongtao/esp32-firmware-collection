menu "Example Configuration"
    config EXAMPLE_USE_DMA2D_COPY_FRAME
        bool "Use DMA2D to copy draw buffer to frame buffer"
        default y
        help
            Enable this option, DMA2D will be used to copy the LVGL draw buffer to the target frame buffer.
            This can save some CPU time and improve the performance.

    config EXAMPLE_LCD_BACKLIGHT_BYPASS_PWM
        bool "Bypass PWM and force backlight always on"
        default n
        help
            Enable this option to drive the backlight pin as a fixed high level instead of PWM.
            This is useful for diagnosing whether visible flicker comes from PWM dimming or from the display pipeline.

    config EXAMPLE_LVGL_PERF_LOG
        bool "Log LVGL refresh performance"
        default y
        help
            Log LVGL refresh, render, and flush timing to help distinguish UI rendering FPS from panel refresh rate.

    config EXAMPLE_LVGL_DRAW_BUF_LINES
        int "LVGL draw buffer lines"
        range 10 200
        default 80
        help
            Number of LCD lines in each LVGL partial draw buffer.
            Smaller values reduce single-buffer size and internal memory pressure.
            Larger values reduce flush count but consume more memory.

    choice
        prompt "LVGL draw buffer memory"
        default EXAMPLE_LVGL_DRAW_BUF_PSRAM
        help
            Select where the LVGL partial draw buffers are allocated from.

        config EXAMPLE_LVGL_DRAW_BUF_PSRAM
            bool "PSRAM"
        config EXAMPLE_LVGL_DRAW_BUF_INTERNAL
            bool "Internal RAM"
    endchoice

    config EXAMPLE_ENABLE_TEST_SDCARD
        bool "Enable SD card (SDMMC) test module"
        default n
        help
            Enable this option to initialize the SDMMC host, mount a FAT filesystem
            on the SD card, and run a read/write test at boot. Requires an SD card
            connected to the pins defined in test_config.h.

    config EXAMPLE_ENABLE_TEST_RTC
        bool "Enable RX8025T-UC RTC test module"
        default n
        help
            Enable this option to probe the board-mounted RX8025T-UC RTC on
            the shared touch I2C bus (I2C_NUM_1, GPIO7/8), read its time and
            status registers, sync invalid time from firmware build time, and
            start a periodic task to print decoded time every 5 seconds.

    config EXAMPLE_ENABLE_TEST_AUDIO
        bool "Enable audio (I2S + ES8311) test module"
        default n
        help
            Enable this option to initialize the I2S peripheral and ES8311 codec,
            start the audio backend task, and expose three UI-triggered actions:
            play embedded canon.pcm, record audio into memory, and replay the
            recorded audio. The codec shares the touch I2C bus. GPIO20 is used
            for the power amplifier enable.

    config EXAMPLE_ENABLE_TEST_BATTERY
        bool "Enable battery voltage monitor test module"
        default y
        help
            Enable this option to initialize ADC2 channel 3 on GPIO52, sample
            the BAT divider midpoint (68K/100K), and expose battery voltage and
            percent state to the integrated LVGL demo.

    config EXAMPLE_VOICE_VOLUME
        int "Audio output volume"
        range 0 100
        default 60
        depends on EXAMPLE_ENABLE_TEST_AUDIO
        help
            Set the ES8311 codec output volume (0-100).

    choice EXAMPLE_MIC_GAIN
        prompt "Microphone gain"
        depends on EXAMPLE_ENABLE_TEST_AUDIO
        default MIC_GAIN_18DB

        config MIC_GAIN_0DB
            bool "0dB"
        config MIC_GAIN_6DB
            bool "6dB"
        config MIC_GAIN_12DB
            bool "12dB"
        config MIC_GAIN_18DB
            bool "18dB"
        config MIC_GAIN_24DB
            bool "24dB"
        config MIC_GAIN_30DB
            bool "30dB"
        config MIC_GAIN_36DB
            bool "36dB"
        config MIC_GAIN_42DB
            bool "42dB"
    endchoice

    config EXAMPLE_MIC_GAIN
        int
        default 0 if MIC_GAIN_0DB
        default 1 if MIC_GAIN_6DB
        default 2 if MIC_GAIN_12DB
        default 3 if MIC_GAIN_18DB
        default 4 if MIC_GAIN_24DB
        default 5 if MIC_GAIN_30DB
        default 6 if MIC_GAIN_36DB
        default 7 if MIC_GAIN_42DB

    config EXAMPLE_ENABLE_TEST_USB
        bool "Enable USB Device CDC-ACM (virtual serial) test module"
        default n
        help
            Enable this option to install a TinyUSB CDC-ACM Device echo demo on
            the board's High-Speed USB Device port. The board enumerates as a
            virtual serial port on the PC side, dumps received data in hex, and
            echoes it back unchanged. On ESP32-P4 the demo uses the internal
            high-speed USB device controller, so no GPIO assignment is needed
            in application code.

endmenu
